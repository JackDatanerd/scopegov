# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App URLs
NEXT_PUBLIC_APP_URL=https://app.bastionhq.com
NEXT_PUBLIC_PORTAL_URL=https://sign.bastionhq.com

# AI
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Email — Resend
RESEND_API_KEY=your_resend_key
RESEND_FROM_EMAIL=noreply@mail.bastionhq.com
RESEND_FROM_NAME=Bastion

# Inbound — Postmark
POSTMARK_INBOUND_WEBHOOK_SECRET=your_postmark_secret
NEXT_PUBLIC_GUARDIAN_EMAIL_DOMAIN=guard.bastionhq.com

# Payments — Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PLAN_SOLO_MONTHLY=PLN_...
PAYSTACK_PLAN_STARTER_MONTHLY=PLN_...
PAYSTACK_PLAN_PRO_MONTHLY=PLN_...
PAYSTACK_PLAN_AGENCY_MONTHLY=PLN_...
PAYSTACK_PLAN_SOLO_ANNUAL=PLN_...
PAYSTACK_PLAN_STARTER_ANNUAL=PLN_...
PAYSTACK_PLAN_PRO_ANNUAL=PLN_...
PAYSTACK_PLAN_AGENCY_ANNUAL=PLN_...

# Cron
CRON_SECRET=your_32_hex_char_secret

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
SENTRY_DSN=https://...@sentry.io/...
